# Server Configuration
PORT=3000
# In production, set this to your custom subdomain (e.g. https://verify.elevatifier.com) or Render URL
BASE_URL=http://localhost:3000

# MongoDB Database Connection
# If left empty in local development, it gracefully falls back to local persistent storage.
# In production on Render, provide your MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/elevatifier?retryWrites=true&w=majority
MONGODB_URI=

# Razorpay API Credentials
# Get these from Razorpay Dashboard (Settings -> API Keys)
# If empty, the application runs in Sandbox/Demo mode so you can test end-to-end without payment friction!
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin Bypass Secret
# Allows the admin to generate FREE certificates without payment
ADMIN_SECRET=elevatifier_admin_2026

# Support Contact Email
SUPPORT_EMAIL=contact@elevatifier.com

# Render Free Pod Keep-Alive Service
# Automatically pings ${BASE_URL}/healthz every 13 minutes to prevent the free Render pod from sleeping
KEEP_ALIVE=true

